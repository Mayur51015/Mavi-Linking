# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017/mavi-linking

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRE=7d

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:5173

# ─── Platform Owner Account ─────────────────────────────────────────────────
# The owner account clears requireOwner, requireSuperAdmin and requireAdmin, so
# it can read and write every tenant on the platform.
#
# Both variables are REQUIRED when NODE_ENV=production — the server refuses to
# start without them rather than falling back to a default that is public in
# this repository. OWNER_PASSWORD must be at least 12 characters.
#
# Leave them unset in development and the server generates a random password,
# prints it once at boot, and marks the account must-change-at-first-login.
OWNER_EMAIL=
OWNER_PASSWORD=

# Comma-separated list of existing accounts to grant super_admin at boot.
# Unset means grant it to nobody. Suspended accounts are skipped, so this can't
# be used to undo a lockout. Only list addresses on a domain you control — any
# address here can be claimed by whoever registers it.
#
# The older singular SUPER_ADMIN_EMAIL is still read and merged into this list,
# so an operator who set it previously keeps working. Prefer SUPER_ADMIN_EMAILS
# and unset the singular form.
SUPER_ADMIN_EMAILS=

# Set to true to insert three sample institutions into an empty database.
# Off by default so a fresh developer or CI database stays empty.
SEED_DEFAULT_INSTITUTIONS=false

# GitHub API token (optional, improves GitHub rate limits)
GITHUB_TOKEN=

# OpenAI API Key for AI Insights
OPENAI_API_KEY=
