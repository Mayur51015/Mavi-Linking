# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017/mavilinking

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRE=7d

# Frontend & Public URLs (CORS & Deep Links)
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:5000
PUBLIC_APP_URL=http://localhost:5173

# Gemini AI API Key
GEMINI_API_KEY=your_gemini_api_key_here

# GitHub API Token (Optional, for higher rate limits)
GITHUB_TOKEN=your_github_personal_access_token_here

# Brevo SMTP Email Configuration (Nodemailer)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your_brevo_login_email@example.com
SMTP_PASS=xsmtpsib-your_brevo_smtp_key_here
MAIL_FROM="EduTalentX Security" <verified_sender@example.com>

# Legacy Email Configuration Fallbacks (Supported)
# EMAIL_HOST=smtp-relay.brevo.com
# EMAIL_PORT=587
# EMAIL_USER=your_brevo_login_email@example.com
# EMAIL_PASS=xsmtpsib-your_brevo_smtp_key_here
# EMAIL_FROM="EduTalentX Security" <verified_sender@example.com>

# Razorpay B2B Billing & Webhook Configuration (Placeholders ONLY)
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=placeholder_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=placeholder_razorpay_webhook_secret

# Supabase Storage Configuration (Backend Service Role Only — Never Expose to Client)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here



