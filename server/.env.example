# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017/mavi-linking

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRE=7d

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:5173

# GitHub API token (optional, improves GitHub rate limits)
GITHUB_TOKEN=

# OpenAI API Key for AI Insights
OPENAI_API_KEY=

# How many times to retry the initial MongoDB connection before giving up.
# Each retry backs off exponentially (1s, 2s, 4s, 8s, capped at 15s), so a
# brief blip during a deploy no longer kills the container.
MONGODB_MAX_CONNECT_ATTEMPTS=5
