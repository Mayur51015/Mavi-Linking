# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017/mavilinking

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRE=7d

# Frontend & Public URLs (CORS & Deep Links)
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:5000
PUBLIC_APP_URL=http://localhost:5173

# Gemini AI API Key
GEMINI_API_KEY=your_gemini_api_key_here

# GitHub API Token (Optional, for higher rate limits)
GITHUB_TOKEN=your_github_personal_access_token_here

# ─── Transactional Email Delivery (Render Free Compatible) ───
# Render Free tier blocks outbound ports 25, 465, and 587.
# Use Option 1 (Brevo REST API) or Option 2 (Resend REST API) for zero-block HTTPS delivery.

# Option 1: Brevo REST API / SMTP (Port 443 / 2525) - Recommended for Render
# If BREVO_API_KEY is provided or SMTP_PASS starts with xkeysib-, emails are sent via HTTPS (port 443).
BREVO_API_KEY=xkeysib-your_brevo_api_key_here
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=2525
SMTP_USER=your_brevo_smtp_login
SMTP_PASS=your_brevo_smtp_key
MAIL_FROM="EduTalentX Security" <your_verified_sender_email@domain.com>

# Option 2: Resend REST API (HTTPS port 443)
# RESEND_API_KEY=re_your_resend_api_key_here

# Legacy Email Configuration Fallbacks (Supported)
# EMAIL_HOST=smtp-relay.brevo.com
# EMAIL_PORT=2525
# EMAIL_USER=your_brevo_smtp_login
# EMAIL_PASS=your_brevo_smtp_key
# EMAIL_FROM="EduTalentX Security" <your_verified_sender_email@domain.com>

# Razorpay B2B Billing & Webhook Configuration (Placeholders ONLY)
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=placeholder_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=placeholder_razorpay_webhook_secret

# Supabase Storage Configuration (Backend Service Role Only — Never Expose to Client)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here



