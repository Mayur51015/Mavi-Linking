# API Base URL (default for development is http://localhost:5000/api)
VITE_API_URL=http://localhost:5000/api
VITE_SOCKET_URL=http://localhost:5000
VITE_APP_URL=http://localhost:5173

# Supabase Authentication (Publishable / Anon Client-Safe Keys ONLY)
# Never expose your SUPABASE_SERVICE_ROLE_KEY to the frontend client!
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_anon_key

# Third-Party Integrations
VITE_GOOGLE_CLIENT_ID=your_google_client_id
VITE_RAZORPAY_KEY_ID=your_razorpay_key_id
